{
  "compilerOptions": {
    "allowJs": true,
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2020",
    
    "lib": [
      "es2017",
      "dom"
    ],
    "types": [
      "node",
      "@webgpu/types",
      "@types/stats"

    ],
    "module": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": [
    "node_modules"
  ]
}
